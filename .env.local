# ==========================================
# 🛢️ PostgreSQL Database
# ==========================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=collab_db
POSTGRES_PORT=5432

# ==========================================
# ⚙️ Backend (NestJS + Prisma)
# ==========================================
BACKEND_PORT=3002
# หมายเหตุ: host ใช้ชื่อบริการ 'postgres' ตามที่ตั้งใน compose.yml
DATABASE_URL=postgresql://postgres:postgrespassword@postgres:5432/collab_db?schema=public

# ==========================================
# 🎨 Frontend (Next.js)
# ==========================================
FRONTEND_PORT=3000
NEXT_PUBLIC_WS_URL=http://localhost:3002